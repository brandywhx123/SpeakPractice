<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml - 应用清单文件
    英语发音训练助手 (English Pronunciation Training Assistant)

    权限说明:
    1. RECORD_AUDIO       - 录音权限，用于麦克风采集用户发音（核心权限，需动态申请）
    2. INTERNET           - 网络权限，语音识别服务需要联网（RecognizerIntent 依赖云端识别）
    3. ACCESS_NETWORK_STATE - 检测网络状态，用于语音识别前判断网络可用性
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== 权限声明区 ==================== -->

    <!-- 录音权限: SpeechRecognizer 调用麦克风采集语音数据所必需 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 网络权限: Android 原生 SpeechRecognizer 使用云端识别服务，需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 网络状态权限: 检测当前是否有可用网络连接 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ==================== 硬件特性声明 ==================== -->
    <!-- 声明应用需要麦克风硬件（非必需硬件，允许无麦克风设备安装） -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- ==================== 应用配置 ==================== -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        tools:targetApi="34">

        <!-- 主 Activity: 应用的入口，包含 TTS 播放、语音识别、文本对比逻辑 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
